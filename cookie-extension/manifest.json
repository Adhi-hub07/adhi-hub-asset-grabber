{
  "manifest_version": 3,
  "name": "ADHI-HUB Cookie Helper",
  "version": "1.0",
  "description": "One click — copies your .ROBLOSECURITY cookie for ADHI-HUB Asset Grabber",
  "permissions": ["cookies", "clipboardWrite"],
  "host_permissions": ["https://www.roblox.com/*", "https://roblox.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}